generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  passwordHash     String?
  phone            String?
  avatar           String?
  bio              String?
  city             String?
  rating           Float     @default(0)
  completedOrders  Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  orders           Order[]   @relation("authorOrders")
  applications     Application[]
  reviewsAuthored  Review[]  @relation("authorReviews")
  reviewsReceived  Review[]  @relation("receiverReviews")
  messages         Message[]
  notifications    Notification[]
}

model Order {
  id              String       @id @default(cuid())
  title           String
  description     String
  category        String
  price           Int
  workersNeeded   Int
  workersSelected Int          @default(0)
  city            String
  district        String?
  address         String?
  date            DateTime?
  time            String?
  urgency         String       @default("NORMAL")
  status          OrderStatus  @default(OPEN)
  authorId        String
  author          User         @relation(fields: [authorId], references: [id], name: "authorOrders")
  images          OrderImage[]
  applications    Application[]
  reviews         Review[]
  chat            Chat?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model OrderImage {
  id      String @id @default(cuid())
  url     String
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])
}

model Application {
  id        String      @id @default(cuid())
  message   String
  status    AppStatus   @default(PENDING)
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Chat {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  messages  Message[]
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id])
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  text      String
  createdAt DateTime @default(now())
  readAt    DateTime?
}

model Review {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  authorId   String
  author     User     @relation("authorReviews", fields: [authorId], references: [id])
  receiverId String
  receiver   User     @relation("receiverReviews", fields: [receiverId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([orderId, authorId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum OrderStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AppStatus {
  PENDING
  ACCEPTED
  REJECTED
}
